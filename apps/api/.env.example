# Plantilla de configuración. Nunca subas un `.env` a git.
# - Docker Compose: copia este archivo a `.env` en la RAÍZ del repo (lo usa la interpolación del compose).
# - API fuera de Docker (`uv run uvicorn`): copia a `apps/api/.env` y usa `localhost` en DATABASE_URL.

# --- Base de datos (contenedor `db`) ---
POSTGRES_USER=bt
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=bermudeztech
# La API se conecta con asyncpg. En compose el host es `db`; fuera de Docker usa `localhost`.
DATABASE_URL=postgresql+asyncpg://bt:cambia-esta-clave@db:5432/bermudeztech

# --- Secretos (obligatorios, ≥ 32 caracteres aleatorios: `openssl rand -base64 48`) ---
JWT_SECRET=
PASSWORD_RESET_PEPPER=

# --- Usuario inicial (solo se usa si la base no tiene usuarios) ---
# Se recomienda borrar INITIAL_USER_PASSWORD después del primer despliegue.
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
INITIAL_USER_DISPLAY_NAME=

# --- Correo (opcional; sin estas variables la recuperación de contraseña no envía nada) ---
RESEND_API_KEY=
MAIL_FROM=BermudezTechOS <no-reply@tu-dominio.com>

# --- Red y otros ---
# Proxies de confianza para tomar la IP real del cliente (X-Forwarded-For). En Coolify, la red del proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# Orígenes permitidos para la app web, separados por coma.
CORS_ORIGINS=
# Publica /docs y /openapi.json (solo desarrollo).
DOCS_ENABLED=false
LOG_LEVEL=INFO
